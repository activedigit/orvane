# =====================================================================
# عروض | Quotation marketplace — environment configuration
# Copy to .env.local and fill in. Everything has a sensible local default.
# =====================================================================

# ---- App
NEXT_PUBLIC_APP_NAME=عروض
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (PostgreSQL). For Supabase use the "Session pooler" or direct connection string
#      from Project Settings → Database (postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/orood
# DATABASE_POOL_MAX=10

# ---- Authentication provider: "local" (bcrypt + signed cookie, no external service) or "supabase" (Supabase Auth)
AUTH_PROVIDER=local
# Secret for signing local sessions (32+ random chars). Required in production when AUTH_PROVIDER=local.
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Supabase (required when AUTH_PROVIDER=supabase or STORAGE_PROVIDER=supabase; also enables Realtime chat)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private

# ---- File storage: "local" (./storage folder) or "supabase" (private bucket)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Reject images that could not be scanned/redacted (needs an OCR provider) instead of approving them
IMAGE_MODERATION_STRICT=false

# ---- AI provider: "rules" (offline keyword engine, default) or "anthropic" (LLM with automatic fallback to rules)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Payments: "mock" (built-in test checkout) or "moyasar" (Mada, Apple Pay, Visa/Mastercard, STC Pay)
PAYMENT_GATEWAY=mock
MOYASAR_SECRET_KEY=
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=

# ---- Notification channels (in-app is always on). Adapters log to the console until a provider is connected.
EMAIL_ENABLED=false
WHATSAPP_ENABLED=false
PUSH_ENABLED=false
